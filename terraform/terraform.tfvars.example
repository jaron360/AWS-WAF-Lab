# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

region      = "us-east-1"
name        = "homelab-web"
environment = "lab"

# Networking
vpc_cidr           = "10.20.0.0/16"
single_nat_gateway = true

# Web tier
instance_type  = "t3.micro"
instance_count = 2

# Access. Default is open to the internet (public web app behind WAF).
# Restrict to your own IP to keep it private:
# allowed_http_cidrs = ["203.0.113.4/32"]
allowed_http_cidrs = ["0.0.0.0/0"]

# WAF
waf_rate_limit         = 2000
waf_log_retention_days = 14
